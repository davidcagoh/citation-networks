# Keep the SQLite file inside this private local project directory for Slice 1.
WORKBENCH_DATABASE_URL=sqlite:///.data/workbench.db

# Public browser configuration; never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
WORKBENCH_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Optional OpenAlex polite-pool contact address; not a secret.
OPENALEX_EMAIL=

# Later provider slices may point the process at a legacy shared env file.
# The application must load it without copying or exposing its values.
WORKBENCH_SHARED_ENV_FILE=../lit-review-bot/litdiscover/.env

# Optional Zotero integration; keep both values server-side and out of NEXT_PUBLIC_*.
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=users
