# Secrets (shared legacy env files are loaded by path; never copied here)
.env*
!.env.example

# Python
backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/**/*.pyc
backend/**/__pycache__/
backend/workbench.db*

# JavaScript
frontend/node_modules/
frontend/.next/
frontend/coverage/
frontend/*.tsbuildinfo

# Local runtime data
.data/
*.log
